{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "growmos hook session-start 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "growmos hook stop 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
