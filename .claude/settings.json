{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "growmos context --brief 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "growmos scan --quiet 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
